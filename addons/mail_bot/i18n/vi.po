#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "help"
msgstr "giúp"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "i love you"
msgstr "yêu bạn"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "love"
msgstr "love"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
#, python-format
msgid "start the tour"
msgstr "khởi động chuyến tham quan"
