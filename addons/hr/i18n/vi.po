#: code:addons/hr/models/res_users.py:0
msgid ""
"You are not allowed to create an employee because the user does not have "
"access rights for %s"
msgstr ""
"Bạn không được phép tạo nhân viên vì người dùng không có quyền truy cập đối "
"với %s"

#. module: hr
#. odoo-python
#: code:addons/hr/models/res_users.py:0
msgid ""
"You are receiving this message because you are the HR Responsible of this "
"employee."
msgstr ""
"Bạn nhận được thông báo này vì bạn là người phụ trách nhân sự của nhân viên "
"này."

#. module: hr
#. odoo-javascript
#: code:addons/hr/static/src/core/common/store_service_patch.js:0
msgid "You can only chat with employees that have a dedicated user."
msgstr ""
"Bạn chỉ có thể trò chuyện với nhân viên có tài khoản người dùng chuyên dụng."

#. module: hr
#. odoo-python
#: code:addons/hr/models/resource_calendar.py:0
msgid ""
"You can't change this working schedule, it's used by employees from other "
"companies you don't have access to. Contact your admin or create a new "
"working schedule."
msgstr ""
"Bạn không thể thay đổi lịch làm việc này vì nó đang được nhân viên ở các "
"công ty khác mà bạn không có quyền truy cập sử dụng. Hãy liên hệ quản trị "
"viên hoặc tạo lịch làm việc mới."

#. module: hr
#. odoo-python
#: code:addons/hr/models/hr_employee.py:0
msgid ""
"You can't end the collaboration of an employee without contract, archive it "
"instead."
msgstr ""
"Bạn không thể kết thúc hợp tác với nhân viên chưa có hợp đồng, hãy lưu trữ "
"nhân viên đó thay thế."

#. module: hr
#. odoo-python
#: code:addons/hr/models/hr_employee.py:0
msgid ""
"You can't modify the departure of an employee that has already departed."
msgstr "Bạn không thể sửa việc nghỉ việc của nhân viên đã nghỉ việc."

#. module: hr
#. odoo-python
#: code:addons/hr/models/res_partner.py:0
msgid ""
"You cannot delete contact that are linked to an employee, please archive "
"them instead."
msgstr ""
"Bạn không thể xóa liên hệ đang liên kết với nhân viên, hãy lưu trữ chúng "
"thay thế."

#. module: hr
#. odoo-python
#: code:addons/hr/models/res_partner.py:0
msgid ""
"You cannot delete contact(s) linked to employee(s).\n"
"Please archive them instead.\n"
"\n"
"Affected contact(s): %(names)s"
msgstr ""
"Bạn không thể xóa (các) liên hệ đang liên kết với (các) nhân viên.\n"
"Vui lòng lưu trữ chúng thay thế.\n"
"\n"
"Liên hệ bị ảnh hưởng: %(names)s"

#. module: hr
#. odoo-python
#: code:addons/hr/models/hr_work_location.py:0
msgid "You cannot delete locations that are being used by your employees"
msgstr "Bạn không thể xóa các địa điểm đang được nhân viên sử dụng"

#. module: hr
#. odoo-javascript
#: code:addons/hr/static/src/views/form/multi_version_update_confirmation_dialog.xml:0
msgid ""
"You changed an old version of the employee. Do you want to apply the "
"following changes to future versions too?"
msgstr ""
"Bạn đã thay đổi một phiên bản cũ của nhân viên. Bạn có muốn áp dụng các thay"
" đổi sau cho cả các phiên bản sau này không?"

#. module: hr
#. odoo-python
#: code:addons/hr/models/hr_employee.py:0
msgid "You do not have access to this document."
msgstr "Bạn không có quyền truy cập vào tài liệu này."

#. module: hr
#. odoo-python
#: code:addons/hr/models/hr_employee.py:0
msgid "You do not have the rights to load the Employees sample data."
msgstr "Bạn không có quyền tải dữ liệu mẫu của Nhân viên."

#. module: hr
#. odoo-python
#: code:addons/hr/wizard/hr_bank_account_allocation_wizard_line.py:0
msgid "You do not have the rights to trust or un-trust accounts."
msgstr "Bạn không có quyền đánh dấu tin cậy hoặc bỏ tin cậy tài khoản."

#. module: hr
#. odoo-python
#: code:addons/hr/models/hr_version.py:0
msgid "Your HR Responsible has been updated to %s."
msgstr "Người phụ trách nhân sự của bạn đã được cập nhật thành %s."

