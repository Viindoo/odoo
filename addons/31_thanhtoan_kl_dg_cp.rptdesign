            <xml-property name="queryText"><![CDATA[
select ROW_NUMBER() OVER (Partition  by dv_nhang) as stt,
coalesce(dv_nhang,'') as dv_nhanhang ,
coalesce(dc_giao,'') as dc_giao,
coalesce(kho_xuat,'') as kho_xuat,
NPK as npk,Lan as lan,SPKhac as khac,LanNC as lannc,
coalesce(NPK,0) + coalesce(Lan,0) + coalesce(SPKhac,0) + coalesce(LanNC,0)  as tong,
(coalesce(NPK,0) + coalesce(Lan,0) + coalesce(SPKhac,0) + coalesce(LanNC,0))*dongia as thanh_tien,
dongia as gia_cuoc,kho_xuat
from
(select A.dv_nhang,A.dc_giao,A.dongia,A.kho_xuat,
sum(B.NPK) as NPK,sum(C.Lan) as Lan,sum(D.SPKhac) as SPKhac,sum(E.LanNC) as LanNC
from
(	select pvc.id as id,pvc.name,rp.ten_day_du as dv_nhang,rd.name as kho_xuat,st.name as dc_giao,
	ct.thanh_tien as dongia
	from icsc_denghithanhtoan_vanchuyen dn
	left join icsc_denghithanhtoan_vanchuyen_chitiet dnt on dnt.phieu_id = dn.id
	left join icsc_phieu_vanchuyen pvc on pvc.id = dnt.so_phieu_vc
	left join icsc_phieu_vanchuyen_chitiet ct on ct.phieu_id = pvc.id
	left join res_partner rp on pvc.donvi_nhanhang = rp.id
	left join res_partner rp3 on pvc.congty_vc = rp3.id   
	left join product_product p on ct.product_id = p.id
	left join product_template pt on p.product_tmpl_id = pt.id
	left join product_category pc on pt.categ_id = pc.id
	left join icsc_hopdong_vanchuyen_giacuoc_kehoach kh on pvc.kehoach_vanchuyen = kh.id
	left join res_country_diadiem d on d.id = kh.cuoc_den_diem
	left join res_country_state st on st.id = d.state_id
	left join res_partner rd on kh.tu_diem = rd.id
	where ct.state not in ('draft','cancel') and pvc.state not in ('draft','cancel')
	and rp3.id = ? and dn.thanhtoan_tungay >= ? and dn.thanhtoan_denngay <= ?
	group by pvc.id,pvc.name,rp.ten_day_du,rd.name,st.name,ct.thanh_tien
)A 
left join
(SELECT id,sum(kl_npk) as NPK
  FROM
	(select pvc.id,case when COALESCE(pvc.tung_phan,FALSE)=true then ctvc.kl_dangvc_dukien
		  else ctvc.kl_vc end as kl_npk
		  from icsc_phieu_vanchuyen pvc
		  left join icsc_phieu_vanchuyen_chitiet ctvc on pvc.id=ctvc.phieu_id
		  left join product_product p on p.id = ctvc.product_id
		  left join product_template pt on p.product_tmpl_id=pt.id
		  left join product_category pc on pt.categ_id = pc.id
		  where pvc.state not in ('draft','cancel') and left(pc.code,2)='20'
	)a group by a.id  
)B ON B.id = A.id
left join
(SELECT id,sum(kl_lan_supe) as Lan
  FROM
	(select  pvc.id,case when COALESCE(pvc.tung_phan,FALSE)=true then ctvc.kl_dangvc_dukien
		  else ctvc.kl_vc end as kl_lan_supe  
		  from icsc_phieu_vanchuyen pvc 
		  left join icsc_phieu_vanchuyen_chitiet ctvc on pvc.id=ctvc.phieu_id
		  left join product_product p on p.id = ctvc.product_id
		  left join product_template pt on p.product_tmpl_id=pt.id
		  left join product_category pc on pt.categ_id = pc.id
		  WHERE pvc.state not in ('draft','cancel') and left(pc.code,2)='10'
	)a group by a.id
)C ON C.id = A.id
left join
(SELECT id,sum(kl_spkhac) as SPKhac
  FROM
	(select  pvc.id,case when COALESCE(pvc.tung_phan,FALSE)=true then ctvc.kl_dangvc_dukien
		  else ctvc.kl_vc end as kl_spkhac  
		  from icsc_phieu_vanchuyen pvc 
		  left join icsc_phieu_vanchuyen_chitiet ctvc on pvc.id=ctvc.phieu_id
		  left join product_product p on p.id = ctvc.product_id
		  left join product_template pt on p.product_tmpl_id=pt.id
		  left join product_category pc on pt.categ_id = pc.id
		  WHERE pvc.state not in ('draft','cancel') and left(pc.code,2)='80' or left(pc.code,2)='30'
	)a group by a.id                       
)D ON D.id = A.id
left join
(SELECT id,sum(kl_lannc) as LanNC
  FROM
	  (select  pvc.id,case when COALESCE(pvc.tung_phan,FALSE)=true then ctvc.kl_dangvc_dukien
		  else ctvc.kl_vc end as kl_lannc
		  from icsc_phieu_vanchuyen pvc
		  left join icsc_phieu_vanchuyen_chitiet ctvc on pvc.id=ctvc.phieu_id
		  left join product_product p on p.id = ctvc.product_id
		  left join product_template pt on p.product_tmpl_id=pt.id
		  left join product_category pc on pt.categ_id = pc.id
		  WHERE pvc.state not in ('draft','cancel') and left(pc.code,2)='40'
	  )a group by a.id
)E ON E.id = A.id
group by A.dv_nhang,A.dc_giao,A.dongia,A.kho_xuat
)G]]></xml-property>
