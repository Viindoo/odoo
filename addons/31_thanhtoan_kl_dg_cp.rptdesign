{
    ngay_chuoi=ngay;
}
if (thang&lt;10)
{
  thang_chuoi='0'+BirtStr.trim(thang);
}
else
{
    thang_chuoi=thang;
}
'Căn cứ hợp đồng sô: '+dataSetRow["hopdong"]+' Ngày '+ ngay_chuoi +' Tháng '+ thang_chuoi +' Năm '+dataSetRow["year"]+','</expression>
