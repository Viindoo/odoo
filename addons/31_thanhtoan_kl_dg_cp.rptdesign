            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">stt</property>
                    <property name="nativeName">stt</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">-5</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">sl_haohut</property>
                    <property name="nativeName">sl_haohut</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">loai_sp</property>
                    <property name="nativeName">loai_sp</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">thanh_tien</property>
                    <property name="nativeName">thanh_tien</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">don_gia</property>
                    <property name="nativeName">don_gia</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">name</property>
                    <property name="nativeName">name</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">dv_nhan</property>
                    <property name="nativeName">dv_nhan</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select ROW_NUMBER() OVER (Partition  by dv_nhan) as stt,
sum(sl_haohut) as sl_haohut,loai_sp,sum(thanh_tien) as thanh_tien,
don_gia,name,dv_nhan
from
(
select coalesce(rp.ten_day_du,'...') as dv_nhan,
coalesce(vpct.so_luong,'0') as sl_haohut, 
pc.name as loai_sp,
(vpct.don_gia + vpct.gia_cuoc) as don_gia, lp.name,
((vpct.don_gia + vpct.gia_cuoc)*vpct.so_luong)thanh_tien
from icsc_phieu_vanchuyen pv
left join icsc_phieuvipham_vanchuyen vpvc on pv.id = vpvc.phieu_vanchuyen
left join icsc_phieuvipham_vanchuyen_chitiet vpct on vpct.phieu_id = vpvc.id
left join res_partner rp on vpvc.donvi_nhanhang = rp.id
left join res_partner rp3 on pv.congty_vc = rp3.id
left join product_product p on vpct.product_id = p.id
left join product_template pt on p.product_tmpl_id = pt.id
left join product_category pc on pt.categ_id = pc.id
left join icsc_loai_phat lp on vpvc.ly_do =lp.id
where vpvc.duavao_vipham = True
and pv.state not in ('draft','cancel') and vpvc.state not in ('draft','cancel')
and rp3.id = ?
)a
group by loai_sp,don_gia,dv_nhan,name]]></xml-property>
