            <xml-property name="queryText"><![CDATA[select 
coalesce(to_char(EXTRACT(YEAR FROM dg.create_date),'9999'),'...')||'-'||coalesce(dg.name,' ') as phieu_dn,
coalesce(hd.name,' ') as hopdong, 
coalesce(hd.dien_giai,' ') as phuluc,
coalesce(hr.name_related,' ') as daidien1,coalesce(hj.name,' ') as chucvu1,
coalesce(hr2.name_related,' ') as daidien2,coalesce(hj2.name,' ') as chucvu2,
coalesce(dg.chucvu_khachhang1,' ') as cv_kh1, coalesce(dg.chucvu_khachhang2,' ') as cv_kh2, 
coalesce(rp.name,' ') as khach1, coalesce(rp2.name,' ')as khach2, 
rp3.name as dv_vchuyen,
coalesce(to_char( EXTRACT(DAY FROM hd.ngay_ki),'99' ),'...') as day,
coalesce(to_char(EXTRACT(MONTH FROM hd.ngay_ki),'99'),'...') as month,
coalesce(to_char(EXTRACT(YEAR FROM hd.ngay_ki),'9999'),'...') as year
from icsc_phieu_vanchuyen pv 
left join icsc_denghithanhtoan_vanchuyen_chitiet dl on dl.so_phieu_vc = pv.id
left join icsc_denghithanhtoan_vanchuyen dg on dl.phieu_id = dg.id
left join icsc_hopdong_vanchuyen hd on dg.hp_vanchuyen = hd.id
left join hr_employee hr on dg.daidien_lamthao1 = hr.id
left join hr_employee hr2 on dg.daidien_lamthao2 = hr2.id
left join hr_job hj on dg.chucvu_lamthao1 = hj.id
left join hr_job hj2 on dg.chucvu_lamthao2 = hj2.id
left join res_partner rp on dg.daidien_khachhang1 = rp.id
left join res_partner rp2 on dg.daidien_khachhang2 = rp2.id
left join res_partner rp3 on dg.tennha_vanchuyen = rp3.id
where pv.ngay_vc between ? and ? and rp3.id = ?
]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
