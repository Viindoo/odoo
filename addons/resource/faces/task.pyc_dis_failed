def YearlyMax(value):
    """
    Calculates a load parameter with a maximal yearly workload
    """
    try:
        cal = me.calendar
    except NameError:
        cal = pcalendar._default_calendar

    time_diff = cal.Minutes(value)
    return float(time_diff) / (cal.working_days_per_year * cal.working_hours_per_day * 60)


