msgstr "Thời hạn phiên"

#. module: auth_timeout
#: model_terms:ir.ui.view,arch_db:auth_timeout.auth_passkey_groups_form
msgid ""
"The screen of the users in this group will be locked after a defined delay"
msgstr ""
"Màn hình của người dùng trong nhóm này sẽ bị khóa sau một khoảng thời "
"gian xác định"

#. module: auth_timeout
#: model_terms:ir.ui.view,arch_db:auth_timeout.auth_passkey_groups_form
msgid ""
"The users in this group will be automatically logout at regular intervals"
msgstr "Người dùng trong nhóm này sẽ tự động bị đăng xuất theo chu kỳ đều đặn"

#. module: auth_timeout
#: model:ir.model.fields,help:auth_timeout.field_res_groups__lock_timeout_inactivity
msgid ""
"Time (in minutes) of user inactivity after which re-authentication is "
"required."
msgstr ""
"Thời gian (tính bằng phút) người dùng không hoạt động, sau đó yêu cầu "
"xác thực lại."

#. module: auth_timeout
#: model:ir.model.fields,help:auth_timeout.field_res_groups__lock_timeout
msgid ""
"Time interval (in minutes) after which re-authentication is required, "
"regardless of inactivity."
msgstr ""
"Khoảng thời gian (tính bằng phút) sau đó yêu cầu xác thực lại, bất kể "
"người dùng có hoạt động hay không."

