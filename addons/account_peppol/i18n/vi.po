#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"A 0% tax cannot use Tax Category 'S' (Standard). Please update the Tax "
"Category in the Advanced Options of the tax configuration."
msgstr ""
"Thuế 0% không thể dùng loại thuế 'S' (Tiêu chuẩn). Vui lòng cập nhật loại "
"thuế trong Tùy chọn nâng cao của cấu hình thuế."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/models/account_edi_proxy_user.py:0
msgid ""
"A Peppol response declaring you %(status)s this document could not be sent "
"to the Peppol Access Point."
msgstr ""
"Không thể gửi tới Điểm truy cập Peppol phản hồi Peppol thông báo rằng bạn "
"%(status)s chứng từ này."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/models/account_edi_proxy_user.py:0
msgid ""
"A Peppol response was sent to the Peppol Access Point declaring you "
"%(status)s this document."
msgstr ""
"Một phản hồi Peppol đã được gửi tới Điểm truy cập Peppol, thông báo rằng bạn"
" %(status)s chứng từ này."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A Receipt has been received  for a message that was previously sent by the "
"MSH generating this error, but the content does not match the message "
"content (e.g. some part has not been acknowledged, or the digest associated "
"does not match the signature digest, for NRR)."
msgstr ""
"Đã nhận được Biên nhận cho một thông điệp trước đây được gửi bởi MSH đang "
"tạo ra lỗi này, nhưng nội dung không khớp với nội dung thông điệp gốc (VD: "
"một phần nào đó chưa được xác nhận, hoặc mã băm liên quan không khớp với mã "
"băm chữ ký, trong trường hợp NRR)."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A Receipt has not been received  for a message that was previously sent by "
"the MSH generating this error."
msgstr ""
"Chưa nhận được Biên nhận cho một thông điệp trước đây được gửi bởi MSH đang "
"tạo ra lỗi này."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/wizard/peppol_registration.py:0
msgid "A connection to '%s' already exists."
msgstr "Kết nối tới '%s' đã tồn tại."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A fragment is received but a previously received fragment message had the "
"same values for GroupId and FragmentNum"
msgstr ""
"Một đoạn tin đã được nhận nhưng đoạn tin đã nhận được trước đó có cùng giá "
"trị GroupId và FragmentNum."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A fragment is received but more than one fragment message in a group of "
"fragments specifies a value for a compression element."
msgstr ""
"Một đoạn tin đã được nhận, nhưng có trên một đoạn tin trong nhóm các đoạn "
"tin cùng chỉ định giá trị cho phần tử nén."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A fragment is received but more than one fragment message in a group of "
"fragments specifies a value for this element."
msgstr ""
"Một đoạn tin đã được nhận, nhưng có trên một đoạn tin trong nhóm các đoạn "
"tin cùng chỉ định giá trị cho phần tử này."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A fragment is received that relates to a group that was previously rejected."
msgstr ""
"Một đoạn tin được nhận nhưng liên quan đến một nhóm đã bị từ chối trước đó."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A message unit in a bundle was not processed because a related message unit "
"in the bundle caused an error."
msgstr ""
"Một đơn vị thông điệp trong gói đã không được xử lý do có một đơn vị thông "
"điệp liên quan trong cùng gói gây ra lỗi."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/models/res_company.py:0
msgid ""
"A participant with these details has already been registered on the network."
" If you have previously registered to a Peppol service, please deregister."
msgstr ""
"Một người tham gia với thông tin này đã được đăng ký trên mạng. Nếu bạn đã "
"từng đăng ký dịch vụ Peppol trước đây, vui lòng hủy đăng ký trước."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/models/res_company.py:0
msgid "A purchase journal must be used to receive Peppol documents."
msgstr "Phải sử dụng sổ nhật ký mua hàng để nhận chứng từ Peppol."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A responding MSH indicates that it applies the alternate MEP binding to the "
"response message."
msgstr ""
"Một MSH phản hồi cho biết nó áp dụng ràng buộc MEP thay thế cho thông điệp "
"phản hồi."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A value is set for FragmentCount, but a previously received fragment had a "
"greature value."
msgstr ""
"Một giá trị đã được đặt cho FragmentCount, nhưng một đoạn tin nhận trước đó "
"có giá trị lớn hơn."

