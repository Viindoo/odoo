msgstr "Máy xử lý tiền mặt đã hết các loại tiền xu/tiền giấy sau:"

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"The cash machine is busy counting its inventory, please wait a few seconds "
"and retry."
msgstr ""
"Máy xử lý tiền mặt đang kiểm đếm tiền trong máy, vui lòng đợi vài giây rồi "
"thử lại."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"The cash machine is busy with another operation. Do you want to cancel it?"
msgstr ""
"Máy xử lý tiền mặt đang bận với một thao tác khác. Bạn có muốn hủy thao tác"
" đó không?"

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"The cash machine is currently in collection/replenishment mode, please "
"finish this process on the machine before making a payment."
msgstr ""
"Máy xử lý tiền mặt hiện đang ở chế độ thu thập/bổ sung tiền, vui lòng hoàn "
"tất quá trình này trên máy trước khi thực hiện thanh toán."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid "The cash machine is disconnected."
msgstr "Máy xử lý tiền mặt đã bị ngắt kết nối."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid "The cash machine is in use by another POS."
msgstr "Máy xử lý tiền mặt đang được một POS khác sử dụng."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"The cash machine is not ready to start a transaction. Check all the covers "
"are closed and then try again."
msgstr ""
"Máy xử lý tiền mặt chưa sẵn sàng để bắt đầu giao dịch. Hãy kiểm tra tất cả "
"nắp máy đã đóng rồi thử lại."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/screens/payment_screen/payment_lines/payment_lines.xml:0
