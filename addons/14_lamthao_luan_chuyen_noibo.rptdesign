            </list-property>
            <xml-property name="queryText"><![CDATA[select pk.name as phieu_xuat, 
so.name as lenh_xuat,
ai.so_hoa_don as hoadon, 
coalesce(d.name,rs.name) as dia_diem_giao,
pk.ma_vung as ma_quanly,
lc.code||'-'||lc.name as khoxuat,
lc2.name as khonhap,
pk.bang_kiem_soat,
rp2.name as nguoi_vc,
rp3.name as nhanvien, rp6.name as user_name,
to_char(so.date_order,'dd') as day,
to_char(so.date_order,'mm') as month,
to_char(so.date_order,'yyyy') as year,
case when pk.loai_xuatkho='thongthuong' then 'Xuất kho VAT' 
when pk.loai_xuatkho='noibo' then 'Chuyển kho nội bộ' end as loai_xuat,
case when pk.loai_vanchuyen='oto' then 'Ô tô (Đường sắt - Ô tô; Đường thủy - Ô tô; Kho - Ô tô' 
when pk.loai_vanchuyen='nhan_tai_ga' then 'Nhận tại ga (Cảng; Kho ngoài)' end as loai_vanchuyen
from account_invoice ai
left join stock_picking pk on pk.hoa_don_id = ai.id
left join stock_move mv on mv.picking_id = pk.id
left join stock_location lc on mv.location_id = lc.id
left join stock_location lc2 on mv.location_dest_id = lc2.id
left join sale_order so on ai.lenh_xuat_hang_id = so.id
left join sale_order_line sl on sl.order_id = so.id
left join res_partner rp2 on rp2.id = ai.daidien_muahangs
left join res_partner rp3 on rp3.id = ai.partner_id
left join res_partner rp4 on sl.dia_chi_giao = rp4.id
left join res_country_state rs on rp4.state_id = rs.id
left join res_country_district d on d.id = rp4.district_id
left join res_users ru on ru.id = ai.write_uid
left join res_partner rp6 on rp6.id = ru.partner_id
where ai.loai_hoadon = 'noibo' and pk.loai_xuatkho='noibo' and pk.state ='done' 
and mv.state not in ('draft','cancel') and pk.mistake_delivery != True and ai.id = ?
and ai.state not in ('draft','cancel')]]></xml-property>
