#. module: hr_holidays
#: model:mail.template,body_html:hr_holidays.new_timeoff_request_template
msgid ""
"<div>\n"
"                    Dear <b><t t-out=\"object.env.context.get('manager')\"></t></b>,\n"
"                    <br><br>\n"
"                    <p>I'm requesting a Time Off. I would appreciate if you could approve it whenever possible!</p>\n"
"                    <ul>\n"
"                        <li>Time Type: <t t-out=\"object.work_entry_type_id.name\"></t></li>\n"
"                        <li><t t-out=\"object.request_date_from\"></t> → <t t-out=\"object.request_date_to\"></t> (<t t-out=\"object.duration_display\"></t>)</li>\n"
"                        <li t-if=\"object.name\">Reason: <t t-out=\"object.name\"></t></li>\n"
"                    </ul>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    Kính gửi <b><t t-out=\"object.env.context.get('manager')\"></t></b>,\n"
"                    <br><br>\n"
"                    <p>Tôi xin gửi đơn nghỉ phép. Rất mong bạn duyệt đơn sớm nhất có thể!</p>\n"
"                    <ul>\n"
"                        <li>Loại nghỉ: <t t-out=\"object.work_entry_type_id.name\"></t></li>\n"
"                        <li><t t-out=\"object.request_date_from\"></t> → <t t-out=\"object.request_date_to\"></t> (<t t-out=\"object.duration_display\"></t>)</li>\n"
"                        <li t-if=\"object.name\">Lý do: <t t-out=\"object.name\"></t></li>\n"
"                    </ul>\n"
"                </div>\n"
"            "

#. module: hr_holidays
#: model:mail.template,body_html:hr_holidays.mail_template_allocation_confirmed
msgid ""
"<div>\n"
"                    Dear <t t-out=\"object.employee_id.name or 'Employee'\"></t>,<br><br>\n"
"                    Your time off allocation has been confirmed.<br><br>\n"
"                    Details:<br>\n"
"                    <ul>\n"
"                        <li>Time Type: <t t-out=\"object.work_entry_type_id.name or ''\"></t></li>\n"
"                        <li>Allocation: <t t-out=\"object.duration_display or ''\"></t></li>\n"
"                        <li>Valid From: <t t-out=\"object.date_from or ''\"></t> <t t-if=\"not object.date_to\">(No Expiry)</t><t t-else=\"\"> to <t t-out=\"object.date_to or ''\"></t></t></li>\n"
"                        <li t-if=\"object.accrual_plan_id\">Accrual Plan: <t t-out=\"object.accrual_plan_id.name or ''\"></t></li>\n"
"                    </ul>\n"
"                    <br>\n"
"                    For any questions, contact HR Responsible.<br><br>\n"
"                    Regards,<br>\n"
"                    <t t-out=\"object.env.user.name or ''\"></t>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    Kính gửi <t t-out=\"object.employee_id.name or 'Employee'\"></t>,<br><br>\n"
"                    Phân bổ phép của bạn đã được xác nhận.<br><br>\n"
"                    Chi tiết:<br>\n"
"                    <ul>\n"
"                        <li>Loại nghỉ: <t t-out=\"object.work_entry_type_id.name or ''\"></t></li>\n"
"                        <li>Phân bổ: <t t-out=\"object.duration_display or ''\"></t></li>\n"
"                        <li>Có hiệu lực từ: <t t-out=\"object.date_from or ''\"></t> <t t-if=\"not object.date_to\">(Không hết hạn)</t><t t-else=\"\"> đến <t t-out=\"object.date_to or ''\"></t></t></li>\n"
"                        <li t-if=\"object.accrual_plan_id\">Kế hoạch tích lũy: <t t-out=\"object.accrual_plan_id.name or ''\"></t></li>\n"
"                    </ul>\n"
"                    <br>\n"
"                    Nếu có thắc mắc, vui lòng liên hệ Phụ trách nhân sự.<br><br>\n"
"                    Trân trọng,<br>\n"
"                    <t t-out=\"object.env.user.name or ''\"></t>\n"
"                </div>\n"
"            "

