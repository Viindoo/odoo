<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="employee_task_tree" model="ir.ui.view">
		<field name="name">employee.task.tree</field>
		<field name="model">employee.task</field>
		<field name="arch" type="xml">
			<list string="Employee Tasks" sample = "1">
				<field name="name"/>
				<field name="employee_user_id" widget = "many2one_avatar_user"/>
				<field name="difficulty"/>
				<field name="priority"/>
				<field name="start_date"/>
				<field name="end_date"/>
				<field name="status" widget = "badge"
				       decoration-success="status == 'completed'"
                       decoration-danger="status == 'ongoing'"/>
			</list>
		</field>
	</record>

	<record id="employee_task_search" model="ir.ui.view">
		<field name="name">employee.task.search</field>
		<field name="model">employee.task</field>
		<field name="arch" type="xml">
			<search string="Search Tasks">
				<field name="employee_id"/>
				<field name="priority"/>
				<group expand="1" string="Group By">
					<filter name="employee" string="Employee" context="{'group_by':'employee_id'}"/>
					<filter name="priority" string="Priority" context="{'group_by':'priority'}"/>
					<filter name="status" string="Status" context="{'group_by':'status'}"/>
					<separator/>
					<filter name="active" string="Archieved" domain = "[('active','=', False)]"/>
				</group>
			</search>
		</field>
	</record>

	<record id="employee_task_form" model="ir.ui.view">
		<field name="name">employee.task.form</field>
		<field name="model">employee.task</field>
		<field name="arch" type="xml">
			<form string="Task Form">
				<header>
					<button name="action_confirm" string="Finished" class="btn-primary" type="object" groups="hr_manager.group_employee_manager"/>
					<field name="status"
				       widget="statusbar"/>
				</header>
				<sheet>
					<widget name="web_ribbon"
					        title="Archived"
					        bg_color="bg-success"
					        invisible = "active"/>

					<field name = "name" placeholder = "Enter task title" style = "font-size: 30px; font-weight: bold; color: #2c3e50; margin: 20px 0; width: 100%;" nolabel = "1"></field>
					<group>
						<group>
							<field name="employee_id"/>
							<field name="priority" widget = "statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
							<field name="difficulty" widget = "statusbar" options="{'clickable': '1'}"/>
							<field name="notes"/>
						    <field name="start_date"/>
							<field name="end_date"/>
							<field name = "active" invisible = '1'/>
<!--							<field name="subtask_suggestions" options = "{'readonly' : ['manager', '=', False]}"/>-->
<!--							<button name="action_generate_subtasks"-->
<!--							        type="object"-->
<!--							        string="Generate Subtasks"-->
<!--							        class="btn-primary"-->
<!--							        groups="hr_manager.group_employee_manager"/>-->
						</group>
					</group>
				</sheet>
                <chatter reload_on_post="True"/>
			</form>
		</field>
	</record>
	
	<record id="view_employee_task_calendar" model="ir.ui.view">
	    <field name="name">employee.task.custom.calendar</field>
	    <field name="model">employee.task</field>
	    <field name="arch" type="xml">
			<calendar
			    string="Task Calendar"
			    date_start="start_date"
			    date_stop="end_date"
			    color="employee_id">
			    <field name="name"/>
			</calendar>
	    </field>
	</record>
	
	<record id="view_employee_task_activity" model="ir.ui.view">
	    <field name="name">employee.task.activity</field>
	    <field name="model">employee.task</field>
	    <field name="arch" type="xml">
	        <activity string="Task Activities">
	            <field name="employee_id"/>
	            <templates>
					<div t-name = "activity-box">
						<div>
							<field name = "employee_id" display = "full"/>
						</div>
						
					</div>
				</templates>
	        </activity>
	    </field>
	</record>
	
	<record id="view_employee_task_pivot" model="ir.ui.view">
	    <field name="name">employee.task.pivot</field>
	    <field name="model">employee.task</field>
	    <field name="arch" type="xml">
	        <pivot string="Employee Task Pivot Analysis">
	            <field name="status" type="row"/>
	            <field name="id" widget="count"/>
	        </pivot>
	    </field>
	</record>
	
	<record id="view_employee_task_graph" model="ir.ui.view">
	    <field name="name">employee.task.graph</field>
	    <field name="model">employee.task</field>
	    <field name="arch" type="xml">
	        <graph string="Employee Graph Analysis" type = "bar">
				<field name="priority" type="row"/>
	            <field name="status" type="col"/>
	            <field name="id" widget="count"/>
	        </graph>
	    </field>
	</record>
	
	
	<record id="employee_task_user_rule" model="ir.rule">
	    <field name="name">My Task Only</field>
	    <field name="model_id" ref="model_employee_task"/>
	    <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
	    <field name="groups" eval="[(4, ref('hr_manager.group_employee_user'))]"/>
	</record>
	
	<record id="employee_task_manager_rule" model="ir.rule">
	    <field name="name">All Task - Manager</field>
	    <field name="model_id" ref="model_employee_task"/>
	    <field name="domain_force">[(1,'=',1)]</field>
	    <field name="groups" eval="[(4, ref('hr_manager.group_employee_manager'))]"/>
	</record>
	
	<record id = "employee_task_action" model = "ir.actions.act_window">
		<field name="name">Employees Task</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.task</field>  
        <field name="view_mode">list,calendar,graph,pivot,activity,form</field>
        <field name="context">{'default_scale': 'year'}</field>
        <field name="help" type="html">
            <p class="test">Create a new Task Schedule</p>
        </field>
	</record>
</odoo>
