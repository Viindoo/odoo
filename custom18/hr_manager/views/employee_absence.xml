<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="employee_absence" model="ir.ui.view">
		<field name="name">employee.absence.tree</field>
		<field name="model">employee.absence</field>
		<field name="arch" type="xml">
			<list string="Employee Absence" sample = "1">
				<field name = "employee_user_id" widget = "many2one_avatar_user"/>
				<field name="absence_type"/>
				<field name="start_date"/>
				<field name="end_date"/>
				<field name="absence_status" widget = "badge" 
				       decoration-success="absence_status == 'approved'"
                       decoration-danger="absence_status == 'refused'"
                       decoration-warning="absence_status == 'draft'"/>
			</list>
		</field>
	</record>

	<record id="employee_absence_search" model="ir.ui.view">
		<field name="name">employee.absence.search</field>
		<field name="model">employee.absence</field>
		<field name="arch" type="xml">
			<search string="Search Absence">
				<field name = "name"/>
				<group expand="1" string="Group By">
					<filter name="absence_status" string="Absence Status" context="{'group_by':'absence_status'}"/>
					<filter name="absence_type" string="Absence Type" context="{'group_by':'absence_type'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="employee_absence_form" model="ir.ui.view">
		<field name="name">employee.absence.form</field>
		<field name="model">employee.absence</field>
		<field name="arch" type="xml">
			<form string="Task Form">
				<header>
					<button name="action_confirm" string="Confirm" class="btn-primary" type="object" groups="hr_manager.group_employee_manager"/>
                    <button name="action_refuse" string="Refuse" class="btn-primary" type="object" groups="hr_manager.group_employee_manager"/>
					<field name="absence_status" widget = "statusbar"/>
				</header>
				<sheet>
					<group string = "Absence">
						<group>
							<field name="absence_type"/>
						    <field name="start_date"/>
							<field name="end_date"/>
							<field name="notes"/>
						</group>
					</group>
				</sheet>
				<chatter reload_on_post="True"/>
			</form>
		</field>
	</record>
	
	<record id="view_employee_absence_calendar" model="ir.ui.view">
	    <field name="name">employee.absence.custom.calendar</field>
	    <field name="model">employee.absence</field>
	    <field name="arch" type="xml">
			<calendar string="Absence Calendar" date_start="start_date" date_stop="end_date" color="employee_id">
			    <field name="display_name"/>
			</calendar>
	    </field>
	</record>
	
	<record id="view_employee_absence_graph" model="ir.ui.view">
	    <field name="name">employee.absence.graph</field>
	    <field name="model">employee.absence</field>
	    <field name="arch" type="xml">
	        <graph string="Employee Absence Graph Analysis" type = "bar">
				<field name="absence_type" type="row"/>
	            <field name="id" widget="count"/>
	        </graph>
	    </field>
	</record>

	<record id="employee_absence_user_rule" model="ir.rule">
	    <field name="name">My Absence Only</field>
	    <field name="model_id" ref="model_employee_absence"/>
	    <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
	    <field name="groups" eval="[(4, ref('hr_manager.group_employee_user'))]"/>
	</record>
	
	<record id="employee_absence_manager_rule" model="ir.rule">
	    <field name="name">All Absences - Manager</field>
	    <field name="model_id" ref="model_employee_absence"/>
	    <field name="domain_force">[(1,'=',1)]</field>
	    <field name="groups" eval="[(4, ref('hr_manager.group_employee_manager'))]"/>
	</record>
	
	<record id="employee_absence_action" model="ir.actions.act_window">
		<field name="name">Employee absence</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">employee.absence</field>
		<field name="view_mode">calendar,list,graph,form</field>
		<field name="context">{'default_scale': 'year'}</field>
		<field name="help" type="html">
			<p class="test">Create and manage employee absence.</p>
		</field>
	</record>
</odoo>
