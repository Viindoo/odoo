<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id = "employee_review_tree" model = 'ir.ui.view'>
		<field name = "name">employee.performance.review.tree</field>
		<field name = "model">employee.performance.review</field>
		<field name = "arch" type = "xml">
			<list string = "Employee Performance Review" sample = "1">
				<field name = "employee_user_id" widget = "many2one_avatar_user"/>
				<field name = "reviewer_user_id" widget = "many2one_avatar_user"/>
				<field name = "review_date"/>
				<field name = "score"/>
				<field name = "status" widget = "badge"
				       decoration-success="status == 'finished'"
                       decoration-warning="status == 'on wait'"/>
			</list>
		</field>
	</record>
	
	<record id = "employee_review_form" model = 'ir.ui.view'>
		<field name = "name">employee.performance.review.form</field>
		<field name = "model">employee.performance.review</field>
		<field name = "arch" type = "xml">
			<form string="Employee Review Form">
				<header>
					<field name="status" widget = "statusbar" clickable = "1"/>
				</header>
			    <sheet>
			        <group string = "Review Information">
			            <group>
			                <field name="employee_id"/>
			                <field name="score" />
			                <field name="notes"/>
			            </group>
			            <group>
			                <field name="reviewer_id" />
			                <field name="review_date"/>
			            </group>
			        </group>
			    </sheet>
			</form>
		</field>
	</record>
	
	<record id = "employee_review_search" model = "ir.ui.view">
		<field name="name">employee.review.tree.search</field>
	    <field name="model">employee.performance.review</field>
	    <field name="arch" type="xml">
			<search string = "Search Employee Performance Review">
				<field name="employee_id"/>
	            <field name="reviewer_id"/>
	            <field name="review_date"/>
			    <group expand="1" string="Group By">
					<filter name="score" string="Score" domain="[]" context="{'group_by' : 'score'}"/>
					<filter name="status" string="Status" domain="[]" context="{'group_by' : 'status'}"/>
			    </group>
			</search>
		</field>
	</record>
	
	<record id="view_employee_performance_review_calendar" model="ir.ui.view">
	    <field name="name">employee.performance.review.calendar</field>
	    <field name="model">employee.performance.review</field>
	    <field name="arch" type="xml">
	        <calendar string="Review Schedule"
	                  date_start="review_date"
	                  color="employee_user_id">
	            <field name="display_name"/>
	        </calendar>
	    </field>
	</record>
	
	<record id="employee_peformance_review_user_rule" model="ir.rule">
	    <field name="name">My Performance Review Only</field>
	    <field name="model_id" ref="model_employee_performance_review"/>
	    <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
	    <field name="groups" eval="[(4, ref('hr_manager.group_employee_user'))]"/>
	</record>
	
	<record id="employee_peformance_review_manager_rule" model="ir.rule">
	    <field name="name">All Performance Review - Manager</field>
	    <field name="model_id" ref="model_employee_performance_review"/>
	    <field name="domain_force">[(1,'=',1)]</field>
	    <field name="groups" eval="[(4, ref('hr_manager.group_employee_manager'))]"/>
	</record>
	
	<record id = "employee_performance_review_action" model = "ir.actions.act_window">
		<field name="name">Employees Performance Review</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.performance.review</field>  
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'default_scale': 'year'}</field>
        <field name="help" type="html">
            <p class="test">Create a new Performance Review</p>
        </field>
	</record>
</odoo>