<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id = "employee_training_tree" model = 'ir.ui.view'>
		<field name = "name">employee.training.tree</field>
		<field name = "model">employee.training</field>
		<field name = "arch" type = "xml">
			<list string = "Employee Training" sample = "1">
				<field name = "name"/>
				<field name = "provider"/>
				<field name = "start_date"/>
				<field name = "end_date"/>
				<field name = "status" widget = "badge"
				       decoration-success="status == 'completed'"
                       decoration-warning="status == 'ongoing'"/>
			</list>
		</field>
	</record>
	
	<record id = "employee_training_search" model = "ir.ui.view">
		<field name="name">employee.training.tree.search</field>
	    <field name="model">employee.training</field>
	    <field name="arch" type="xml">
			<search string = "Search Employee Training">
				<field name="name"/>
	            <field name="provider"/>
	            <field name="start_date"/>
	            <field name="end_date"/>
			    <group expand="1" string="Group By">
					<filter name="status" string="Status" domain="[]" context="{'group_by' : 'status'}"/>
					<filter name="provider" string="Provider" domain="[]" context="{'group_by' : 'provider'}"/>
			    </group>
			</search>
		</field>
	</record>
	
	<record id = "employee_training_form" model = 'ir.ui.view'>
		<field name = "name">employee.training.form</field>
		<field name = "model">employee.training</field>
		<field name = "arch" type = "xml">
			<form string="Employee Training Form">
				<header>
					<field name="status" widget = "statusbar" clickable = "1"/>
				</header>
			    <sheet>
			        <group>
			            <group>
			                <field name="name" />
			                <field name="start_date" />
			            </group>
			            <group>
			                <field name="provider" />
			                <field name="end_date"/>
			                <field name="notes" />
			            </group>
			            <group>
							<field name="employee_ids"/>
						</group>
			        </group>
			    </sheet>
			</form>
		</field>
	</record>
	
	<record id="view_employee_training_calendar" model="ir.ui.view">
	    <field name="name">employee.training.calendar</field>
	    <field name="model">employee.training</field>
	    <field name="arch" type="xml">
	        <calendar string="Training Schedule"
	                  date_start="start_date"
	                  date_stop="end_date"
	                  color="provider">
	            <field name="name"/>
	        </calendar>
	    </field>
	</record>
	

	
	<record id = "employee_traning_action" model = "ir.actions.act_window">
		<field name="name">Employees Training</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.training</field>  
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'default_scale': 'year'}</field>
        <field name="help" type="html">
            <p class="test">Create a new Training Schedule</p>
        </field>
	</record>
</odoo>