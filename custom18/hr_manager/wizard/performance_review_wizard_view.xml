<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_performance_review_wizard_form" model="ir.ui.view">
    <field name="name">performance.review.wizard.form</field>
    <field name="model">performance.review.request.wizard</field>
    <field name="arch" type="xml">
      <form string="Request Performance Review">
		  <group>
			 <group>
	          <field name="employee_id"/>
	          <field name="reviewer_id"/>
	          <field name="review_date"/>
	        </group>
	        <group>
			</group>
		  </group>
        <footer>
          <button name="action_submit" string="Submit" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  
  <record id="action_performance_review_wizard" model="ir.actions.act_window">
	  <field name="name">Request Performance Review</field>
	  <field name="res_model">performance.review.request.wizard</field>
	  <field name="view_mode">form</field>
	  <field name = "view_id" ref = "view_performance_review_wizard_form"/>
	  <field name="target">new</field>
	</record>

</odoo>