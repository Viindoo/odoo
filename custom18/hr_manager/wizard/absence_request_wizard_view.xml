<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_absence_request_wizard_form" model="ir.ui.view">
    <field name="name">absence.request.wizard.form</field>
    <field name="model">absence.request.wizard</field>
    <field name="arch" type="xml">
      <form string="Request Absence">
		  <group>
			 <group>
	          <field name="absence_type"/>
	          <field name="start_date"/>
	          <field name="end_date"/>
	          <field name="notes"/>
	        </group>
	        <group>
			</group>
		  </group>
        <footer>
          <button name="action_submit" string="Submit" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  
  <record id="action_absence_request_wizard" model="ir.actions.act_window">
	  <field name="name">Request Absence</field>
	  <field name="res_model">absence.request.wizard</field>
	  <field name="view_mode">form</field>
	  <field name = "view_id" ref = "view_absence_request_wizard_form"/>
	  <field name="target">new</field>
	</record>

</odoo>